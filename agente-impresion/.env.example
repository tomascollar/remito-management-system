# Configuración del agente de impresión. Copiá este archivo como ".env" y completalo.
# El archivo .env NO se sube a Git (contiene la clave del agente).

# Dirección de la aplicación en Render (sin barra final). Debe ser https.
SERVIDOR_URL=https://TU-APP.onrender.com

# Clave del agente: es el valor de IMPRESION_AGENTE_TOKEN que está en Render (Environment).
AGENTE_TOKEN=

# IP de la impresora en la red del puesto (la que figura en su hoja de configuración)
IMPRESORA_HOST=192.168.0.228

# Opcionales (estos son los valores por defecto)
# IMPRESORA_PUERTO=9100
# INTERVALO_MS=3000          # cada cuánto pregunta si hay tickets (1000 a 60000)
# TIMEOUT_IMPRESORA_MS=8000  # cuánto espera a que la impresora responda
# CORTE=parcial              # parcial | total | ninguno
