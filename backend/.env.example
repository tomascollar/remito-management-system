# Copiá este archivo a ".env" (que está en .gitignore) y completá los valores. NUNCA subas el .env real.

# --- Obligatorias ---
# Cadena de conexión de MongoDB Atlas (con usuario de aplicación de permisos limitados, no el admin).
MONGODB_URI=mongodb+srv://USUARIO:CLAVE@cluster.xxxxx.mongodb.net/remitos?retryWrites=true&w=majority
# Secreto para firmar los JWT. En producción: mínimo 32 caracteres aleatorios.
# Generar:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# --- Opcionales ---
NODE_ENV=development
PORT=5000
# Cantidad de proxies delante de la app. Render = 1 (valor por defecto en producción). 0 = ninguno.
# TRUST_PROXY=1
# Solo si el frontend se sirviera desde OTRO dominio (no es el caso con Render de un solo servicio).
# CORS_ORIGIN=https://otro-dominio.com
# Ruta al frontend compilado (por defecto ../frontend/dist).
# FRONTEND_DIST=
# Laboratorio de seguridad (solo superadmin). Dejar apagado en producción salvo para una demostración.
# SECURITY_LAB=true
